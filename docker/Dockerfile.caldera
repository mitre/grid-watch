FROM python:3.10-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends git curl gcc g++ nodejs npm golang-go && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /opt

# Clone Caldera with submodules (manx and magma Vue UI come in via --recurse-submodules)
RUN git clone --depth 1 --branch 5.3.0 --recurse-submodules --shallow-submodules \
        https://github.com/apache/caldera.git && \
    git clone --depth 1 --recursive https://github.com/mitre/caldera-ot.git /tmp/caldera-ot

# Copy OT plugin directories into Caldera's plugins folder
RUN for plugin in /tmp/caldera-ot/*/; do \
        name=$(basename "$plugin"); \
        if [ -d "$plugin" ] && [ "$name" != ".git" ]; then \
            cp -r "$plugin" /opt/caldera/plugins/"$name"; \
        fi; \
    done && \
    rm -rf /tmp/caldera-ot

# Caldera loads every subdirectory of plugins/ at startup and exits(0) if any
# lacks a hook.py (happens with uninitialised git submodules). Remove them.
RUN find /opt/caldera/plugins -mindepth 1 -maxdepth 1 -type d | while read d; do \
        [ -f "$d/hook.py" ] || rm -rf "$d"; \
    done

WORKDIR /opt/caldera

# Build the magma Vue UI (required by rest_api.py to serve /assets)
RUN cd plugins/magma && npm install --legacy-peer-deps && npm run build

# Install Caldera dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Build sandcat for the current platform so the agent container can run it natively.
RUN cd plugins/sandcat/gocat && \
    { GOOS=linux GOARCH="$(go env GOARCH)" go build -o ../payloads/sandcat-linux . && \
      echo "sandcat build succeeded"; } || \
    echo "sandcat build skipped (non-fatal)"

COPY docker/caldera-setup.py /tmp/caldera-setup.py
RUN python /tmp/caldera-setup.py dnp3

# Ship this repo's DNP3 fact source and adversary profiles in the dnp3
# plugin's data dir (see README "Caldera OT Integration" setup table), so
# the scenarios are available without a manual copy step.
COPY docs/sources/grid-watch-simulator-facts.yml plugins/dnp3/data/sources/
COPY docs/adversaries/dnp3-reconnaissance.yml \
     docs/adversaries/dnp3-unauthorized-control.yml \
     docs/adversaries/dnp3-grid-disruption.yml \
     docs/adversaries/dnp3-grid-attack-and-verify.yml \
     plugins/dnp3/data/adversaries/

COPY docker/caldera-entrypoint.sh /caldera-entrypoint.sh
RUN chmod +x /caldera-entrypoint.sh

EXPOSE 8888 8443

ENTRYPOINT ["/caldera-entrypoint.sh"]
